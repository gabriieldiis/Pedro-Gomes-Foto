---
/**
 * Foto responsiva: AVIF → WebP → JPG, várias larguras, o navegador escolhe a menor que serve.
 * `sizes` diz ao navegador quanto da tela a foto ocupa — sem isso ele baixa a maior.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  prioridade?: boolean;
  transicao?: string; // nome da view transition (capa que "voa" entre páginas)
  class?: string;
}
const { src, alt, sizes, prioridade = false, transicao, class: classe } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000].filter((w) => w <= src.width);
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  quality={68}
  loading={prioridade ? 'eager' : 'lazy'}
  fetchpriority={prioridade ? 'high' : 'auto'}
  decoding="async"
  pictureAttributes={{ class: classe }}
  style={transicao ? `view-transition-name: ${transicao}` : undefined}
/>
