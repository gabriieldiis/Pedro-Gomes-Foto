---
/**
 * Vídeo em loop que NÃO pesa a página.
 *
 * 1. O que aparece primeiro é o poster (AVIF/WebP, recortado para celular ou desktop).
 *    É ele que conta como "maior elemento" da página, então o carregamento fica rápido.
 * 2. O vídeo só começa a baixar depois que a página terminou de carregar, quando está
 *    visível na tela, e só se a pessoa não pediu menos movimento nem economia de dados
 *    e a conexão não é 2G/3G lenta.
 * 3. Escolhe o arquivo certo: vertical no celular, horizontal no desktop; AV1 quando o
 *    aparelho suporta, H.264 nos outros.
 * 4. Pausa sozinho quando sai da tela e sempre tem um botão de pausar (WCAG 2.2.2).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nome: string; // prefixo em public/video
  posterMobile: ImageMetadata;
  posterDesktop: ImageMetadata;
  prioridade?: boolean; // true só para o vídeo do topo da home
  class?: string;
}
const { nome, posterMobile, posterDesktop, prioridade = false, class: classe } = Astro.props;

const larguras = { mobile: [360, 540, 720], desktop: [960, 1280, 1920] };
const gerar = (img: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpg') =>
  getImage({ src: img, widths: widths.filter((w) => w <= img.width), format, quality: format === 'avif' ? 55 : 70 });

const [mAvif, mWebp, dAvif, dWebp, dJpg] = await Promise.all([
  gerar(posterMobile, larguras.mobile, 'avif'),
  gerar(posterMobile, larguras.mobile, 'webp'),
  gerar(posterDesktop, larguras.desktop, 'avif'),
  gerar(posterDesktop, larguras.desktop, 'webp'),
  gerar(posterDesktop, [1280], 'jpg'),
]);
const retrato = '(orientation: portrait)';
---
<div class:list={['video-leve', classe]} data-video-leve data-nome={nome}>
  <picture>
    <source media={retrato} type="image/avif" srcset={mAvif.srcSet.attribute} sizes="100vw" />
    <source media={retrato} type="image/webp" srcset={mWebp.srcSet.attribute} sizes="100vw" />
    <source type="image/avif" srcset={dAvif.srcSet.attribute} sizes="100vw" />
    <source type="image/webp" srcset={dWebp.srcSet.attribute} sizes="100vw" />
    <img
      src={dJpg.src}
      alt=""
      width={posterDesktop.width}
      height={posterDesktop.height}
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
      decoding={prioridade ? 'sync' : 'async'}
    />
  </picture>
  <video muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true" tabindex="-1"></video>
  <button class="video-leve__botao" type="button" hidden>
    <span class="video-leve__icone" aria-hidden="true"></span>
    <span class="video-leve__rotulo">Reproduzir vídeo</span>
  </button>
</div>

<style>
  .video-leve {
    position: relative;
    overflow: hidden;
    background: var(--escuro);
  }
  .video-leve picture,
  .video-leve img,
  .video-leve video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-leve video {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .video-leve.tocando video { opacity: 1; }

  .video-leve__botao {
    position: absolute;
    right: var(--margem);
    bottom: var(--margem);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.55);
    color: #fff;
    font: inherit;
    font-size: var(--t-pequeno);
    cursor: pointer;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .video-leve__botao[hidden] { display: none; }
  /* ícone: triângulo (play) ou duas barras (pausa) desenhados em CSS */
  .video-leve__icone {
    width: 0.7rem; height: 0.8rem;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .tocando .video-leve__icone {
    clip-path: none;
    background: linear-gradient(90deg, currentColor 0 35%, transparent 35% 65%, currentColor 65%);
  }
  @media (prefers-reduced-motion: reduce) {
    .video-leve video { transition: none; }
  }
</style>

<script>
  type Conexao = { saveData?: boolean; effectiveType?: string };

  const AV1 = 'video/mp4; codecs="av01.0.05M.08"';

  function podeTocarSozinho(): boolean {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    const c = (navigator as Navigator & { connection?: Conexao }).connection;
    if (c?.saveData) return false;
    if (c?.effectiveType && /(^|-)(2g|3g)$/.test(c.effectiveType)) return false;
    return true;
  }

  function iniciar(el: HTMLElement) {
    const video = el.querySelector('video')!;
    const botao = el.querySelector<HTMLButtonElement>('.video-leve__botao')!;
    const rotulo = botao.querySelector('.video-leve__rotulo')!;
    const nome = el.dataset.nome!;
    let carregado = false;
    let pausadoPeloUsuario = false;
    let visivel = false;

    function carregar() {
      if (carregado) return;
      carregado = true;
      const variante = matchMedia('(orientation: portrait)').matches ? 'mobile' : 'desktop';
      const fontes: [string, string][] = [];
      if (video.canPlayType(AV1)) fontes.push([`/video/${nome}-${variante}.av1.mp4`, AV1]);
      fontes.push([`/video/${nome}-${variante}.mp4`, 'video/mp4']);
      for (const [src, type] of fontes) {
        const s = document.createElement('source');
        s.src = src;
        s.type = type;
        video.append(s);
      }
      video.preload = 'auto';
      video.load();
    }

    function atualizar(tocando: boolean) {
      el.classList.toggle('tocando', tocando);
      rotulo.textContent = tocando ? 'Pausar vídeo' : 'Reproduzir vídeo';
      botao.setAttribute('aria-pressed', String(tocando));
    }

    async function tocar() {
      carregar();
      try {
        await video.play();
      } catch {
        atualizar(false); // navegador bloqueou: fica o poster
      }
    }

    video.addEventListener('playing', () => atualizar(true));
    video.addEventListener('pause', () => atualizar(false));

    botao.hidden = false;
    botao.addEventListener('click', () => {
      if (video.paused) {
        pausadoPeloUsuario = false;
        tocar();
      } else {
        pausadoPeloUsuario = true;
        video.pause();
      }
    });

    const automatico = podeTocarSozinho();
    new IntersectionObserver(
      ([entrada]) => {
        visivel = entrada.isIntersecting;
        if (visivel && automatico && !pausadoPeloUsuario) tocar();
        else if (!visivel && !video.paused) video.pause();
      },
      { rootMargin: '0px 0px 200px 0px' },
    ).observe(el);

    // economia de bateria: aba em segundo plano não toca vídeo
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else if (visivel && automatico && !pausadoPeloUsuario) tocar();
    });
  }

  function depoisDoCarregamento(fn: () => void) {
    const ocioso = (cb: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 2000 }) : setTimeout(cb, 200);
    if (document.readyState === 'complete') ocioso(fn);
    else addEventListener('load', () => ocioso(fn), { once: true });
  }

  depoisDoCarregamento(() => {
    document.querySelectorAll<HTMLElement>('[data-video-leve]').forEach(iniciar);
  });
</script>
