---
import '../styles/global.css';
import { site } from '../site.config';
import AvisoPrototipo from '../components/AvisoPrototipo.astro';

interface Props {
  titulo?: string;
  descricao?: string;
  imagemSocial?: string; // URL absoluta ou caminho de uma imagem já otimizada
  sobreVideo?: boolean; // página começa com vídeo no topo (cabeçalho branco por cima)
}
const { titulo, descricao = site.descricao, imagemSocial, sobreVideo = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — ${site.nome}` : `${site.nome} — ${site.especialidade}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const ano = new Date().getFullYear();

const menu = [
  { href: '/#trabalhos', texto: 'Trabalhos' },
  { href: '/#sobre', texto: 'Sobre' },
  { href: '/#contato', texto: 'Contato' },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Aplica o tema antes de pintar a página (evita piscar claro→escuro) -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        d.classList.add('js');
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
        d.dataset.tema = t;
        document.querySelector('meta[name=theme-color]').content = t === 'escuro' ? '#0c0606' : '#f5f5f5';
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    {imagemSocial && <meta property="og:image" content={new URL(imagemSocial, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Chrome/Edge pré-renderizam a página do trabalho quando o dedo/mouse encosta no link. -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/trabalhos/*" }, "eagerness": "moderate" }] }
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <!-- branco por cima do vídeo; ao descer, vira barra de vidro fosco -->
    <header class:list={['topo', { 'sobre-video': sobreVideo }]} data-topo>
      <a class="marca" href="/">{site.nome}</a>
      <div class="topo__acoes">
        <button type="button" class="topo__link tema" data-tema-botao aria-label="Alternar tema claro e escuro">
          <span class="tema__icone" aria-hidden="true"></span>
          <span class="rola tema__rotulo" data-texto="Tema"><span>Tema</span></span>
        </button>
        <a href={`mailto:${site.email}`} class="topo__link">
          <span class="rola" data-texto="Contato"><span>Contato</span></span>
        </a>
        <button type="button" class="topo__link" data-menu-abrir aria-haspopup="dialog">
          <span class="rola" data-texto="Menu"><span>Menu</span></span>
        </button>
      </div>
    </header>

    <dialog class="menu" data-menu aria-label="Menu">
      <div class="menu__topo">
        <a class="marca" href="/">{site.nome}</a>
        <form method="dialog">
          <button class="topo__link" type="submit">
            <span class="rola" data-texto="Fechar"><span>Fechar</span></span>
          </button>
        </form>
      </div>
      <nav aria-label="Principal">
        <ol class="menu__lista">
          {menu.map((item, i) => (
            <li>
              <a href={item.href} data-menu-link>
                <span class="rotulo">{String(i + 1).padStart(2, '0')}</span>
                <span class="display menu__texto">{item.texto}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="menu__rodape">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`https://instagram.com/${site.instagram}`} rel="me">Instagram</a>
      </div>
    </dialog>

    <AvisoPrototipo />

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape conteiner">
      <div class="bloco-verde revela-bloco rodape__bloco">
        <p class="display rodape__frase">{site.nome}</p>
        <div class="rodape__colunas">
          <div>
            <p class="rotulo">Contato</p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <p class="rotulo">Siga</p>
            <a href={`https://instagram.com/${site.instagram}`} rel="me">@{site.instagram}</a>
          </div>
          <div>
            <p class="rotulo">Base</p>
            <p>{site.cidade}, Brasil</p>
          </div>
          <div class="rodape__fim">
            <p class="meta">© {ano} {site.nome}. Todas as fotos são de autoria de {site.nome}.</p>
            <a class="meta" href="#conteudo">Voltar ao topo ↑</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ---------- Cabeçalho ---------- */
  .topo {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: calc(1rem + env(safe-area-inset-top, 0px)) var(--margem) 1rem;
    color: var(--tinta);
    background: color-mix(in srgb, var(--papel) 72%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--linha) 70%, transparent);
    transition: color 0.9s var(--curva-lux), background-color 0.9s var(--curva-lux), border-color 0.9s var(--curva-lux), backdrop-filter 0.9s var(--curva-lux);
    pointer-events: none;
  }
  .topo.sobre-video {
    color: #ffffff;
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .topo > * { pointer-events: auto; }
  .marca {
    font-family: var(--serifa);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .topo__acoes { display: flex; gap: 1.5rem; }
  .topo__link {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  /* botão de tema: círculo meio cheio que gira devagar na troca */
  .tema { gap: 0.55rem; }
  .tema__icone {
    width: 1rem; height: 1rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: transform 1.6s var(--curva-lux);
  }
  :global([data-tema='escuro']) .tema__icone { transform: rotate(180deg); }
  @media (max-width: 30em) {
    .tema__rotulo { display: none; }
    .topo__acoes { gap: 1.1rem; }
  }

  /* ---------- Menu em tela cheia ---------- */
  .menu {
    width: 100vw; max-width: 100vw;
    height: 100dvh; max-height: 100dvh;
    margin: 0;
    padding: calc(1rem + env(safe-area-inset-top, 0px)) var(--margem) calc(var(--margem) + env(safe-area-inset-bottom, 0px));
    border: 0;
    background: var(--grad-bloco);
    background-size: 140% 140%;
    color: var(--tinta);
    overflow: hidden;
    /* mesmas cores claras do .bloco-verde */
    --tinta: #f3f1e6;
    --texto: rgb(243 241 230 / 0.78);
    --apagado: rgb(243 241 230 / 0.6);
  }
  .menu[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .menu::backdrop { background: var(--verde-fundo); }
  .menu > :not(.orb) { position: relative; z-index: 1; }
  .menu__topo { display: flex; justify-content: space-between; align-items: center; }
  .menu nav { align-self: center; }
  .menu__lista { display: grid; gap: 0.25rem; }
  .menu__lista a {
    display: flex; align-items: baseline; gap: 1rem;
    text-decoration: none;
    width: fit-content;
  }
  .menu__texto {
    font-size: clamp(3rem, 12vw, 7.5rem);
    line-height: 1.05;
    transition: opacity 0.9s var(--curva-lux);
  }
  .menu__lista:hover a:not(:hover) .menu__texto { opacity: 0.35; }
  .menu__rodape {
    display: flex; flex-wrap: wrap; gap: 0.5rem 2rem;
    font-size: var(--t-pequeno);
    color: var(--texto);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] { animation: menu-fundo 0.9s var(--curva-lux); }
    .menu[open] .menu__lista li {
      animation: entra 1.4s var(--curva-lux) both;
      animation-delay: 0.15s;
    }
    .menu[open] .menu__lista li:nth-child(2) { animation-delay: 0.27s; }
    .menu[open] .menu__lista li:nth-child(3) { animation-delay: 0.39s; }
    @keyframes menu-fundo { from { opacity: 0; } }
    @keyframes entra { from { opacity: 0; transform: translateY(1.5rem); } }
  }

  /* ---------- Rodapé ---------- */
  .rodape {
    margin-top: var(--secao);
    padding-bottom: calc(var(--margem) + env(safe-area-inset-bottom, 0px));
    font-size: 0.9375rem;
  }
  .rodape__bloco { padding: clamp(2.5rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4.5rem) clamp(1.5rem, 3vw, 2rem); }
  .rodape__frase {
    font-size: var(--t-gigante);
    line-height: 1;
    margin-bottom: 3rem;
    margin-left: -0.04em;
  }
  .rodape__colunas {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr 1fr;
  }
  .rodape__colunas .rotulo { margin-bottom: 0.5rem; }
  .rodape__colunas a { text-decoration: none; }
  .rodape__colunas a:hover { text-decoration: underline; }
  .rodape__fim {
    grid-column: 1 / -1;
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--linha);
  }
  @media (min-width: 48em) {
    .rodape__colunas { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('[data-menu]');
  document.querySelector('[data-menu-abrir]')?.addEventListener('click', () => dialogo?.showModal());
  // fechar ao escolher um item (o link de âncora rola a página por trás)
  dialogo?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => dialogo.close()));

  /* ---------- Troca de tema: círculo que se expande a partir do botão ---------- */
  const raiz = document.documentElement;
  const botaoTema = document.querySelector<HTMLButtonElement>('[data-tema-botao]');
  const metaCor = document.querySelector<HTMLMetaElement>('meta[name=theme-color]');

  function aplicarTema(tema: string) {
    raiz.dataset.tema = tema;
    if (metaCor) metaCor.content = tema === 'escuro' ? '#0c0606' : '#f5f5f5';
    botaoTema?.setAttribute('aria-pressed', String(tema === 'escuro'));
    try { localStorage.setItem('tema', tema); } catch {}
  }
  botaoTema?.setAttribute('aria-pressed', String(raiz.dataset.tema === 'escuro'));

  botaoTema?.addEventListener('click', () => {
    const novo = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!document.startViewTransition || semMovimento) {
      if (!semMovimento) {
        raiz.classList.add('tema-transicao');
        setTimeout(() => raiz.classList.remove('tema-transicao'), 1300);
      }
      aplicarTema(novo);
      return;
    }

    const r = botaoTema.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const raio = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    raiz.classList.add('trocando-tema');
    const transicao = document.startViewTransition(() => aplicarTema(novo));
    transicao.ready.then(() => {
      raiz.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${raio}px at ${x}px ${y}px)`] },
        { duration: 1500, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
    transicao.finished.finally(() => raiz.classList.remove('trocando-tema'));
  });

  /* ---------- Cabeçalho: branco enquanto estiver sobre o vídeo ---------- */
  const topo = document.querySelector<HTMLElement>('[data-topo]');
  const abertura = document.querySelector<HTMLElement>('.abertura');
  if (topo && abertura) {
    const checar = () => topo.classList.toggle('sobre-video', abertura.getBoundingClientRect().bottom > topo.offsetHeight);
    addEventListener('scroll', checar, { passive: true });
    checar();
  }

  /* ---------- Blocos verdes presos ao scroll (com inércia) ---------- */
  const blocos = [...document.querySelectorAll<HTMLElement>('.revela-bloco')].map((el) => {
    [...el.children].forEach((filho, i) => (filho as HTMLElement).style.setProperty('--i', String(i)));
    return { el, alvo: 0, atual: 0 };
  });
  const comMovimento = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (blocos.length && comMovimento) {
    let rodando = false;
    const limitar = (v: number) => Math.min(1, Math.max(0, v));

    function medir() {
      const vh = innerHeight;
      const noFim = scrollY + vh >= document.documentElement.scrollHeight - 4;
      for (const b of blocos) {
        const topo = b.el.getBoundingClientRect().top;
        // 0 quando o topo do bloco encosta no pé da tela; 1 quando chega a 35% da altura
        b.alvo = noFim && topo < vh ? 1 : limitar((vh - topo) / (vh * 0.65));
      }
    }

    function quadro() {
      let falta = false;
      for (const b of blocos) {
        const d = b.alvo - b.atual;
        b.atual = Math.abs(d) < 0.0005 ? b.alvo : b.atual + d * 0.07; // inércia: 7% do caminho por quadro
        if (b.atual !== b.alvo) falta = true;
        const p = b.atual;
        b.el.style.setProperty('--p', p.toFixed(4));
        b.el.style.setProperty('--q', limitar((p - 0.35) / 0.65).toFixed(4));
      }
      rodando = falta;
      if (falta) requestAnimationFrame(quadro);
    }

    function agendar() {
      medir();
      if (!rodando) {
        rodando = true;
        requestAnimationFrame(quadro);
      }
    }

    blocos.forEach((b) => b.el.style.setProperty('--p', '0'));
    addEventListener('scroll', agendar, { passive: true });
    addEventListener('resize', agendar);
    agendar();
  }

  /* ---------- Revelar ao rolar (textos e fotos: uma vez só) ---------- */
  const alvos = document.querySelectorAll('.revela, .cortina');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('visivel');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
    );
    alvos.forEach((el) => io.observe(el));
  } else {
    alvos.forEach((el) => el.classList.add('visivel'));
  }
</script>
